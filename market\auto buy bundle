-- =========================================
-- LOAD RAYFIELD
-- =========================================

local okRay, Rayfield = pcall(function()
    return loadstring(game:HttpGet("https://sirius.menu/rayfield"))()
end)

if not okRay or type(Rayfield) ~= "table" then
    return
end

-- =========================================
-- SERVICES / PLAYER
-- =========================================

local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")

local Player = Players.LocalPlayer
local pg = Player:WaitForChild("PlayerGui")

-- =========================================
-- STATE
-- =========================================

local running = false
local bought = 0
local target = 50
local hotkeysEnabled = true
local activeYesButton = nil
local guiVisible = true

-- =========================================
-- HELPERS
-- =========================================

local function notify(title, content, duration)
    pcall(function()
        Rayfield:Notify({
            Title = title,
            Content = content,
            Duration = duration or 3
        })
    end)
end

local function getMainGui()
    return pg:FindFirstChild("MainGui")
end

local function getBundle()
    local g = getMainGui()
    if not g then return nil end
    local left = g:FindFirstChild("LeftPanel")
    if not left then return nil end
    local hw = left:FindFirstChild("HalloweenUI")
    if not hw then return nil end
    local content = hw:FindFirstChild("Content")
    if not content then return nil end
    return content:FindFirstChild("Material Bundle")
end

local function getPrompts()
    local g = getMainGui()
    if not g then return nil end
    local s = g:FindFirstChild("Subordinates")
    if not s then return nil end
    return s:FindFirstChild("Prompts")
end

local function getMarket()
    local g = getMainGui()
    if not g then return nil end
    local p = g:FindFirstChild("Panels")
    if not p then return nil end
    return p:FindFirstChild("GlobalMarket")
end

local function getHalloweenMarket()
    local g = getMainGui()
    if not g then return nil end

    local panels = g:FindFirstChild("Panels")
    if panels then
        for _, name in ipairs({
            "HalloweenMarket", "HalloweenShop",
            "Halloween", "SpookyMarket"
        }) do
            local m = panels:FindFirstChild(name)
            if m then return m end
        end
    end

    local left = g:FindFirstChild("LeftPanel")
    local hw = left and left:FindFirstChild("HalloweenUI")
    if hw then
        local content = hw:FindFirstChild("Content")
        if content then
            for _, name in ipairs({ "HalloweenMarket", "HalloweenShop", "Market" }) do
                local m = content:FindFirstChild(name)
                if m then return m end
            end
        end
        return hw
    end

    for _, obj in ipairs(g:GetDescendants()) do
        if obj:IsA("GuiObject")
            and (obj.Name == "HalloweenMarket"
                or obj.Name == "HalloweenShop"
                or obj.Name == "SpookyMarket") then
            return obj
        end
    end

    return nil
end

