-- =========================================
-- FIND RAYFIELD SCREEN GUI
-- =========================================

local cachedScreenGui = nil

local function findRayfieldScreenGui()
    if cachedScreenGui and cachedScreenGui.Parent then
        return cachedScreenGui
    end

    local parents = {}
    local okHui, hui = pcall(function()
        return gethui and gethui() or nil
    end)
    if okHui and hui then table.insert(parents, hui) end

    table.insert(parents, pg)

    local okCg, cg = pcall(function()
        return game:GetService("CoreGui")
    end)
    if okCg and cg then table.insert(parents, cg) end

    for _, parent in ipairs(parents) do
        for _, obj in ipairs(parent:GetChildren()) do
            if obj:IsA("ScreenGui") then
                local n = obj.Name:lower()
                if n:find("rayfield") or n:find("utility") or n:find("sirius") then
                    cachedScreenGui = obj
                    return obj
                end
            end
        end
    end

    return nil
end

-- =========================================
-- INPUT
-- Left Shift = toggle GUI
-- H = toggle Halloween Market
-- =========================================

UIS.InputBegan:Connect(function(input, processed)
    if processed then return end
    if UIS:GetFocusedTextBox() then return end

    if input.KeyCode == Enum.KeyCode.LeftShift then
        guiVisible = not guiVisible

        local screen = findRayfieldScreenGui()
        if screen then
            screen.Enabled = guiVisible
        else
            pcall(function()
                Rayfield:Toggle(guiVisible)
            end)
        end

    elseif input.KeyCode == Enum.KeyCode.H and hotkeysEnabled then
        local m = getHalloweenMarket()
        if m then
            m.Visible = not m.Visible
        end
    end
end)

-- =========================================
-- BUTTON CLICKING
-- =========================================

local function clickButton(button)
    if not button or not button.Parent then
        return false
    end

    if type(getconnections) == "function" then
        local ok, result = pcall(function()
            for _, connection in ipairs(getconnections(button.Activated)) do
                if connection.Function then
                    task.spawn(connection.Function)
                    return true
                end
            end
            return false
        end)
        if ok and result then
            return true
        end
    end

    if type(firesignal) == "function" then
        local ok = pcall(firesignal, button.Activated)
        if ok then
            return true
        end
    end

    return pcall(function()
        button:Activate()
    end)
end

local function getYesButton(prompts)
    if activeYesButton and activeYesButton.Parent and activeYesButton.Visible then
        return activeYesButton
    end
    activeYesButton = nil

    if not prompts then return nil end

    for _, obj in ipairs(prompts:GetDescendants()) do
        if obj:IsA("TextButton") and obj.Name == "YesButton" and obj.Visible then
            local parent = obj.Parent
            if parent and parent.Name ~= "Templates" then
                local gp = parent.Parent
                if gp and gp.Name ~= "Templates" then
                    activeYesButton = obj
                    return obj
                end
            end
        end
    end

    return nil
end

-- =========================================
-- AUTO BUY LOOP
-- =========================================

task.spawn(function()
    while true do
        if not running then
            task.wait(0.1)
            continue
        end

        if bought >= target then
            running = false
            notify("Auto Buy", ("Finished: %d"):format(bought), 4)
            task.wait(0.1)
            continue
        end

        local bundle    = getBundle()
        local container = bundle and bundle:FindFirstChild("Container")
        local buyButton = container and container:FindFirstChild("Buy")
        local prompts   = getPrompts()

        if not (buyButton and buyButton.Parent and buyButton.Visible and buyButton.Active) then
            task.wait(0.15)
            continue
        end

        clickButton(buyButton)

        local yesButton
        local tries = 0
        while running and not yesButton and tries < 30 do
            yesButton = getYesButton(prompts)
            if not yesButton then
                task.wait(0.05)
                tries += 1
            end
        end

        if not running then
            continue
        end

        if yesButton then
            if clickButton(yesButton) then
                bought += 1
                activeYesButton = nil
                task.wait(0.2)
            else
                task.wait(0.15)
            end
        else
            activeYesButton = nil
            task.wait(0.15)
        end
    end
end)
